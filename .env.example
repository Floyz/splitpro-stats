# Read-only Postgres role (see sql/create-readonly-role.sql)
DATABASE_URL=postgresql://splitpro_stats:change-me@splitpro-db:5432/splitpro
# Path under which the app is served (must match the Next.js rewrite in the SplitPro fork)
BASE_PATH=/stats
PORT=3100
# NextAuth cookie names, first match wins (HTTPS name first)
SESSION_COOKIE_NAMES=__Secure-next-auth.session-token,next-auth.session-token
